rosette.png

# A stray on Windows: a redirect that names the reserved device creates a real file here.
nul

# scratch for one-off analysis runs; regenerate, never commit
.tmp/

# renders a probe page hands back through PUT /_out/ - look at them, do not commit them
tools/_out/
